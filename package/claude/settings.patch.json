{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/session_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/prompt_capture.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/wiki_context_hint.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/pre_compact_save.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/transcript_capture.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/cc-agent-brain/memory_audit.py --light"
          }
        ]
      }
    ]
  }
}
